{
  "name": "jarvis-nucleo-pessoal",
  "private": true,
  "version": "0.58.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors yellow,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node scripts/python.mjs -m uvicorn server.app:app --reload --host 0.0.0.0 --port 8000",
    "build": "tsc -b && vite build",
    "build:embutido": "npm run build && node scripts/embutir-interface.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/python.mjs -m uvicorn server.app:app --host 0.0.0.0 --port 8000",
    "start:embutido": "node scripts/python.mjs -m uvicorn server.app:create_app --factory --host 127.0.0.1 --port 8000",
    "test": "npm run test:web && npm run test:api",
    "test:web": "vitest run",
    "test:api": "node scripts/python.mjs -m pytest",
    "test:watch": "vitest",
    "checar": "node scripts/checar-pendrive.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
