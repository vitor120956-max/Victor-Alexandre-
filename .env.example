# Copie para .env somente no servidor. Nunca envie a chave pelo chat.
# Qualquer endpoint compatível com OpenAI Chat Completions pode ser usado.
JARVIS_AI_PROVIDER=OpenAI
JARVIS_AI_BASE_URL=https://api.openai.com/v1
JARVIS_AI_MODEL=gpt-4o-mini
JARVIS_AI_API_KEY=

# Pasta isolada das skills de arquivos. Se vazio, usa storage/user-files.
JARVIS_FILES_ROOT=

# --- Camada de sistema (0.30.0) -----------------------------------------
# Token de host: gerado em storage/host-token.txt no primeiro uso.
# Não defina aqui; leia do arquivo e cole na página /sistema.
# Liga a saída para a internet: busca, leitura de página e download.
JARVIS_HOST_REDE=0
# Liga a execução de instalador. Implica rede. Só ligue depois de revisar o plano.
JARVIS_HOST_INSTALAR=0
# 1 esconde o token do log de inicialização (útil em CI). Não use em produção.
JARVIS_HOST_TOKEN_SILENCIOSO=0

# --- Elevação controlada (0.33.0) ---------------------------------------
# Liga a execução como root do plano confirmado (dpkg, rpm e systemctl).
# Desligada, a camada só monta o plano. Exige NOPASSWD no /etc/sudoers.
JARVIS_HOST_ROOT=0
# Unidades que a elevação pode reiniciar ou parar. Vazio = nenhuma.
JARVIS_HOST_SERVICOS=
